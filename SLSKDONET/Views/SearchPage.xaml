<Page x:Class="SLSKDONET.Views.SearchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SearchPage">

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search Input -->
        <Border Grid.Row="0" Background="{StaticResource SecondaryBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16">
            <StackPanel Orientation="Vertical">
                <Label Content="Search for Tracks" Style="{StaticResource ModernLabelStyle}"
                       FontSize="{StaticResource FontSizeMedium}" FontWeight="Bold"/>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <ui:TextBox Name="SearchBox" Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Enter artist, album, or title..."
                                Icon="{ui:SymbolIcon Search24}"
                                Width="400" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <ui:Button Content="Search" Appearance="Primary"
                               VerticalAlignment="Center" Command="{Binding SearchCommand}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <ui:Button Content="Import CSV" Icon="{ui:SymbolIcon DocumentQueue24}" Click="ImportCsvButton_Click"/>
                    <ui:Button Content="Import Spotify" Icon="{ui:SymbolIcon MusicNote224}" Margin="8,0,0,0" Click="ImportSpotifyButton_Click"/>
                    <ui:Button Content="Filters" Icon="{ui:SymbolIcon Filter24}" Margin="8,0,0,0" Command="{Binding ToggleFiltersPanelCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Inline Filter Panel -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" Padding="16"
                Visibility="{Binding IsFiltersPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <Label Content="Active Filters" Style="{StaticResource ModernLabelStyle}" Margin="0,0,0,12"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Column="0" Content="Min Bitrate:" Style="{StaticResource ModernLabelStyle}" VerticalAlignment="Center"/>
                    <ui:TextBox Grid.Column="1" Text="{Binding MinBitrate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                Margin="8,0,16,0" VerticalAlignment="Center"/>

                    <Label Grid.Column="2" Content="Max Bitrate:" Style="{StaticResource ModernLabelStyle}" VerticalAlignment="Center"/>
                    <ui:TextBox Grid.Column="3" Text="{Binding MaxBitrate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                Margin="8,0,16,0" VerticalAlignment="Center"/>

                    <Label Grid.Column="4" Content="Formats:" Style="{StaticResource ModernLabelStyle}" VerticalAlignment="Center"/>
                    <ui:TextBox Grid.Column="5" Text="{Binding PreferredFormats, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                Margin="8,0,0,0" VerticalAlignment="Center"
                                PlaceholderText="e.g., mp3, flac"/>
                </Grid>
                <TextBlock Text="{Binding ActiveFiltersSummary}" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="{StaticResource FontSizeSmall}" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>

        <!-- Results DataGrid -->
        <DataGrid Grid.Row="2" Name="ResultsGrid" ItemsSource="{Binding SearchResults}"
                  Style="{StaticResource ModernDataGridStyle}" Margin="0"
                  AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Extended"
                  SelectionChanged="ResultsGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="150"/>
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Album" Binding="{Binding Album}" Width="120"/>
                <DataGridTextColumn Header="Bitrate" Binding="{Binding Bitrate}" Width="70"/>
                <DataGridTextColumn Header="User" Binding="{Binding Username}" Width="100"/>
                <DataGridTextColumn Header="Size" Binding="{Binding Size, StringFormat={}{0:N0} KB}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Action Buttons -->
        <Border Grid.Row="3" Background="{StaticResource SecondaryBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16">
            <StackPanel Orientation="Horizontal" Height="44">
                <ui:Button Content="Add Selected to Downloads" Icon="{ui:SymbolIcon ArrowDownload24}"
                           Appearance="Primary" VerticalAlignment="Center" Command="{Binding AddToDownloadsCommand}"
                           CommandParameter="{Binding ElementName=ResultsGrid, Path=SelectedItems}"/>
                <TextBlock Text="{Binding SelectedTrackCount, StringFormat='({0} selected)'}"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                           Margin="16,0,0,0" FontSize="{StaticResource FontSizeSmall}"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>