<ui:FluentWindow x:Class="SLSKDONET.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:SLSKDONET.Views" Title="Soulseek Downloader" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowBackdropType="Mica">
    <Grid x:Name="MainGrid">
        <ui:TitleBar Title="Soulseek Downloader" />

        <!-- Root Content Grid -->
        <Grid x:Name="RootContent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Apply blur when login overlay is visible -->
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoginOverlayVisible}" Value="True">
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <BlurEffect Radius="10"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Opacity" Value="0.6"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <!-- Main Navigation -->
            <Grid Grid.Row="1">
                <ui:NavigationView x:Name="RootNavigationView"
                                   PaneDisplayMode="Left"
                                   IsBackButtonVisible="Collapsed" IsPaneToggleVisible="True" HeaderVisibility="Collapsed">
                    <ui:NavigationView.MenuItems>
                        <ui:NavigationViewItem Content="Search" Icon="{ui:SymbolIcon Search24}" Command="{Binding NavigateSearchCommand}" />
                        <ui:NavigationViewItem Content="Imported" Icon="{ui:SymbolIcon DocumentQueue24}" Command="{Binding NavigateImportedCommand}" />
                        <ui:NavigationViewItem Content="Library" Icon="{ui:SymbolIcon Library24}" Command="{Binding NavigateLibraryCommand}" />
                        <ui:NavigationViewItem Content="Downloads" Icon="{ui:SymbolIcon ArrowDownload24}" Command="{Binding NavigateDownloadsCommand}" />
                    </ui:NavigationView.MenuItems>
                    <ui:NavigationView.FooterMenuItems>
                        <ui:NavigationViewItem Content="Settings" Icon="{ui:SymbolIcon Settings24}" Command="{Binding NavigateSettingsCommand}" />
                    </ui:NavigationView.FooterMenuItems>
                </ui:NavigationView>
                <Frame x:Name="RootFrame" Grid.Column="0" Margin="48,0,0,0" NavigationUIVisibility="Hidden"/>
            </Grid>

            <!-- Status Bar -->
            <Border Grid.Row="2" Background="{StaticResource SecondaryBackgroundBrush}" 
                   BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" 
                   Padding="16,10">
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondaryBrush}"
                          FontSize="{StaticResource FontSizeSmall}">
                </TextBlock>
            </Border>
        </Grid>

        <!-- Login Overlay (on top with high z-order) -->
        <Grid x:Name="LoginOverlay" Visibility="{Binding IsLoginOverlayVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Panel.ZIndex="1000">
            <!-- Semi-transparent backdrop -->
            <Border Background="#A6000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <!-- Centered draggable login card -->
            <Grid x:Name="LoginCard" HorizontalAlignment="Center" VerticalAlignment="Center" MouseDown="LoginCard_MouseDown" Width="420">
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="24">
                    <StackPanel>
                        <TextBlock Text="Sign in to Soulseek" FontSize="{StaticResource FontSizeLarge}" FontWeight="Bold" 
                                  Foreground="{StaticResource TextBrush}" Margin="0,0,0,16" HorizontalAlignment="Center"/>

                        <Label Content="Username" Style="{StaticResource ModernLabelStyle}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding Username, Mode=TwoWay}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12"/>

                        <Label Content="Password" Style="{StaticResource ModernLabelStyle}" Margin="0,0,0,6"/>
                        <PasswordBox x:Name="OverlayPasswordBox" Style="{StaticResource ModernPasswordBoxStyle}" Margin="0,0,0,16"/>

                        <CheckBox Content="Remember Password" IsChecked="{Binding RememberPassword, Mode=TwoWay}" 
                                  Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,16"/>

                        <ui:Button Content="Sign In" Command="{Binding LoginCommand}" 
                                   CommandParameter="{Binding ElementName=OverlayPasswordBox, Path=Password}"
                                   Appearance="Primary" Height="44" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>


    </Grid>
</ui:FluentWindow>
